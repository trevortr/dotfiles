mkcd() {
  if [ "$#" -ne 1 ]; then
    echo "Usage: mkcd <directory>" >&2
    return 2
  fi
  mkdir -p "$1" && cd "$1"
}

bak() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: bak <file> [file ...]" >&2
    return 2
  fi
  for file in "$@"; do
    cp -r "$file" "${file}.bak.$(date +%Y%m%d_%H%M%S)"
  done
}

scratch() {
  local dir
  dir=$(mktemp -d /tmp/scratch.XXXXXX)
  cd "$dir" && echo "entered scratchpad: $dir"
}

checkport() {
    if [ "$#" -ne 2 ]; then
        echo "Usage: checkport <host> <port>" >&2
        return 2
    fi
    (echo >/dev/tcp/"$1"/"$2") >/dev/null 2>&1 && echo "Port $2 is open on $1" || echo "Port $2 is closed on $1"
}

httptest() {
    if [ "$#" -ne 1 ]; then
        echo "Usage: httptest <url>" >&2
        return 2
    fi
    curl -o /dev/null -s -w "\
HTTP Code: %{http_code}\n\
DNS Lookup: %{time_namelookup}s\n\
Connect:    %{time_connect}s\n\
TLS Handshake: %{time_appconnect}s\n\
Total Time: %{time_total}s\n" "$1"
}

digq() {
    if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
        echo "Usage: digq <name> [record_type]" >&2
        return 2
    fi
    dig +nocmd "$1" "${2:-A}" +noall +answer
}

# docker

dsh() {
  if [ "$#" -ne 1 ]; then
    echo "Usage: dsh <container_name_or_id>" >&2
    return 2
  fi
  docker exec -it "$1" /bin/bash 2>/dev/null || docker exec -it "$1" /bin/sh
}

dlog() {
  if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "Usage: dlog <container_name_or_id> [tail_lines]" >&2
    return 2
  fi
  local lines="${2:-100}"
  docker logs -f --tail="$lines" "$1"
}

dip() {
  if [ "$#" -ne 1 ]; then
    echo "Usage: dip <container_name_or_id>" >&2
    return 2
  fi
  docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$1"
}

dstopall() {
  local running
  running=$(docker ps -q)
  if [ -n "$running" ]; then
    echo "Stopping all running containers..."
    docker stop $running
  else
    echo "No running containers found."
  fi
}

drmstopped() {
  local stopped
  stopped=$(docker ps -a -q -f status=exited)
  if [ -n "$stopped" ]; then
    echo "Removing stopped containers..."
    docker rm $stopped
  else
    echo "No stopped containers found."
  fi
}

drmi-dangling() {
  local dangling
  dangling=$(docker images -f "dangling=true" -q)
  if [ -n "$dangling" ]; then
    echo "Removing dangling images..."
    docker rmi $dangling
  else
    echo "No dangling images found."
  fi
}
