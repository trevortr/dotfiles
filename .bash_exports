# default text editor / pager
export EDITOR="vim"
export VISUAL="$EDITOR"
export PAGER="less"
export LESS="-FRX"

# history
export HISTSIZE=100000
export HISTFILESIZE=250000
export HISTCONTROL="ignoreboth:erasedups"
export HISTTIMEFORMAT="%F %T  "

# lang
export LANG="${LANG:-C}"
export LC_COLLATE="C"

# tooling and runtime
_dotfiles_prepend_path() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) export PATH="$1:$PATH" ;;
    esac
}
_dotfiles_prepend_path "$HOME/.local/bin"
[[ ! -d "$HOME/go/bin" ]] || _dotfiles_prepend_path "$HOME/go/bin"
[[ ! -d "$HOME/.cargo/bin" ]] || _dotfiles_prepend_path "$HOME/.cargo/bin"
unset -f _dotfiles_prepend_path
